# Não é necessária uma OPENAI_API_KEY. Execute `npm run auth` uma vez.
HOST=127.0.0.1
PORT=3001

# Memória permanente Zep Cloud. Nunca coloque uma chave real neste ficheiro.
# Este User representa exclusivamente o owner humano; Mira é sempre Assistant.
ZEP_API_KEY=
ZEP_USER_ID=mira-main
ZEP_OWNER_NAME=Owner
ZEP_ENABLED=true
ZEP_CONTEXT_TIMEOUT_MS=500
ZEP_CONTEXT_MAX_CHARS=12000
ZEP_INGEST_TIMEOUT_MS=10000
ZEP_OWNER_CAPTION_WAIT_MS=1200

# Opcionais. Por omissão, o estado OAuth fica em .openclaw-state/.
# OPENCLAW_STATE_DIR=/caminho/para/estado/openclaw
# OPENCLAW_AGENT_DIR=/caminho/para/agents/main/agent

# X Space opcional. Também pode ser ligado pela interface em cada arranque.
# X_SPACE_ROOM_ID=1vOxw...
# X_COOKIES_FILE=/home/sauron/.config/kika/twitter.cookies
# X_PYTHON=/caminho/para/.venv-xspace/bin/python
X_SELF_HANDLE=mira_theagent
# Override opcional; normalmente o owner é lido automaticamente da metadata do Space.
# X_OWNER_HANDLE=owner_handle
